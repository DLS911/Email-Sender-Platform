{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter review-ui build",
  "outputDirectory": "apps/review-ui/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/review-ui packages"
}
