{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/daily-grind-generate?mode=tomorrow",
      "schedule": "0 22 * * 0-4"
    },
    {
      "path": "/api/cron/daily-grind-generate?mode=today",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/daily-grind",
      "schedule": "0 * * * 1-5"
    },
    {
      "path": "/api/cron/daily-grind",
      "schedule": "15 * * * 1-5"
    },
    {
      "path": "/api/cron/saturday-latte-generate",
      "schedule": "0 22 * * 5"
    },
    {
      "path": "/api/cron/saturday-latte-generate",
      "schedule": "0 9 * * 6"
    },
    {
      "path": "/api/cron/saturday-latte",
      "schedule": "0 * * * 6"
    }
  ]
}
