{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/daily-grind-generate",
      "schedule": "0 22 * * 0-4"
    },
    {
      "path": "/api/cron/daily-grind",
      "schedule": "0 * * * 1-5"
    }
  ]
}
