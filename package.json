{
  "name": "email-sender-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-brand agentic content + distribution + learning platform",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "registry:sync": "pnpm --filter @platform/voice-modules registry:sync",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "db:reset": "pnpm --filter @platform/db reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
