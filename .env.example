# Email Sender Platform — environment variables
# Copy to .env.local for local dev. Production values live in Vercel/Supabase.
# NEVER commit real values.

# ─── LLM providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ─── Distribution ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SIGNING_SECRET=

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public (review-ui) — must be prefixed NEXT_PUBLIC_ to expose to the client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── GitHub (web archive commits) ──────────────────────────────────────────
GITHUB_PAT=

# ─── Notifications ─────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PLATFORM_ENVIRONMENT=development
